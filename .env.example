# Required: your Anthropic key (set it in Vercel > Settings > Environment Variables, never in code)
ANTHROPIC_API_KEY=

# Optional: model override. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# Optional: free Guardian Open Platform developer key (non-commercial use)
GUARDIAN_API_KEY=

# Optional: free FRED API key (oil, 10-year yield, VIX, dollar index)
FRED_API_KEY=

# Optional: set to "off" to disable Claude's built-in web search ($10 per 1,000 searches)
WEB_SEARCH=

# Optional: extra allowed origins for /api/chat, comma separated (your custom domain is detected automatically)
SITE_ORIGINS=
